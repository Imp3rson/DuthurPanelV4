-- RUNSCRIPT
----------------------------------------------------------------
local function runScript(info, btn)
    if State.loaded[info.url] then
        notify("⚠️ " .. info.name .. " já foi carregado", Color3.fromRGB(255, 180, 0))
        return false
    end
    local ok, err
    if info.url == "ESP_PRO" then
        ok, err = pcall(runESP)
    else
        ok, err = pcall(function()
            loadstring(game:HttpGet(info.url))()
        end)
    end
    if ok then
        State.loaded[info.url] = true
        notify("✅ " .. info.name, CONFIG.GREEN)
    else
        notify("❌ Falha: " .. info.name, Color3.fromRGB(255, 60, 60))
        warn("[Imp3rson] " .. tostring(err))
    end
    return ok
end
_G.Imp3rsonHub.runScript = runScript


            if not State.loaded[info.url] then
                TweenService:Create(btn, TweenInfo.new(0.15),
                    { BackgroundColor3 = CONFIG.ACCENT }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if not State.loaded[info.url] then
                TweenService:Create(btn, TweenInfo.new(0.15),
                    { BackgroundColor3 = baseColor }):Play()
            end
        end)

        btn.MouseButton1Click:Connect(function()
            if btn:GetAttribute("Loading") then return end
            btn:SetAttribute("Loading", true)
            local oldText = info.name
            btn.Text = "⏳ Carregando..."
            local ok = _G.Imp3rsonHub.runScript(info, btn)
            task.wait(0.5)
            if ok then
                btn.Text = "✅ " .. oldText
                btn.BackgroundColor3 = Color3.fromRGB(40, 80, 50)
            else
                btn.Text = "❌ Falhou"
                btn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
                task.delay(2, function()
                    if isSafe(btn) then
                        btn.Text = oldText
                        btn.BackgroundColor3 = baseColor
                    end
                end)
            end
            btn:SetAttribute("Loading", false)
        end)
    end

    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, -16, 0, 32)
    footer.Position = UDim2.new(0, 8, 1, -40)
    footer.BackgroundColor3 = Color3.fromRGB(28, 28, 28)

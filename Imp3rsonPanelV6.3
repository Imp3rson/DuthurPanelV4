----------------------------------------------------------------
-- NOTIFY
----------------------------------------------------------------
local function notify(text, color)
    color = color or CONFIG.ACCENT_BRIGHT
    pcall(function()
        local g = CoreGui:FindFirstChild("Imp3rsonNotify")
        if not g then
            g = Instance.new("ScreenGui")
            g.Name = "Imp3rsonNotify"
            g.ResetOnSpawn = false
            g.IgnoreGuiInset = true
            g.DisplayOrder = 100
            g.Parent = CoreGui
        end
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 260, 0, 44)
        frame.Position = UDim2.new(0.5, -130, 0, -60)
        frame.BackgroundColor3 = CONFIG.BG_DARK
        frame.BorderSizePixel = 0
        frame.Parent = g
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
        local stroke = Instance.new("UIStroke")
        stroke.Color = color; stroke.Thickness = 2; stroke.Parent = frame
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -20, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextWrapped = true
        lbl.Parent = frame
        TweenService:Create(frame, TweenInfo.new(0.3),
            { Position = UDim2.new(0.5, -130, 0, 20) }):Play()
        task.delay(2.2, function()
            if isSafe(frame) then
                local t = TweenService:Create(frame, TweenInfo.new(0.3),
                    { Position = UDim2.new(0.5, -130, 0, -60) })
                t:Play()
                t.Completed:Connect(function()
                    if isSafe(frame) then frame:Destroy() end
                end)
            end
        end)
    end)
end
_G.Imp3rsonHub.notify = notify


local function setHubVisibility(open)
    State.hubOpen = open
    local hub = CoreGui:FindFirstChild("Imp3rsonExtrasHub")
    if hub then hub.Enabled = open end
end

local function toggleHub()
    setHubVisibility(not State.hubOpen)
end
_G.Imp3rsonHub.toggleHub = toggleHub


local function runESP()
    local Players_ = game:GetService("Players")
    local RunService_ = game:GetService("RunService")
    local UIS_ = game:GetService("UserInputService")
    local CoreGui_ = game:GetService("CoreGui")
    local LocalPlayer = Players_.LocalPlayer

    local Settings = {
        Enabled = true, Box = true, Tracers = true, Names = true,
        Distance = true, HealthBar = true, Chams = true,
        TeamCheck = false, AliveCheck = true, MaxDistance = 500,
        TracerOrigin = 1, Color = Color3.fromRGB(255, 45, 45),
    }
    local ORIGINS = {"Bottom", "Center", "Mouse"}

    local drawingOK = pcall(function() local t = Drawing.new("Line") t:Remove() end)
    local cache, unloaded = {}, false

    local function getRoot(char) return char and char:FindFirstChild("HumanoidRootPart") end
    local function getHum(char) return char and char:FindFirstChildOfClass("Humanoid") end

    local function wipeDrawings(c)
        if c.draw then for _, o in pairs(c.draw) do pcall(function() o:Remove() end) end c.draw = nil end
        if c.chams then pcall(function() c.chams:Destroy() end) c.chams, c.chamsChar = nil, nil end
    end

    local function ensureDrawings(c)
        if c.draw then return c.draw end
        local d = {}
        d.box = Drawing.new("Quad"); d.box.Thickness = 1.5; d.box.Filled = false; d.box.ZIndex = 2
        d.tracer = Drawing.new("Line"); d.tracer.Thickness = 1.2; d.tracer.ZIndex = 1
        d.name = Drawing.new("Text"); d.name.Size = 14; d.name.Center = true; d.name.Outline = true; d.name.ZIndex = 3
        d.dist = Drawing.new("Text"); d.dist.Size = 12; d.dist.Center = true; d.dist.Outline = true; d.dist.ZIndex = 3
        d.hpBg = Drawing.new("Line"); d.hpBg.Thickness = 4; d.hpBg.Color = Color3.fromRGB(0,0,0); d.hpBg.ZIndex = 2
        d.hpFill = Drawing.new("Line"); d.hpFill.Thickness = 2.5; d.hpFill.ZIndex = 3
        c.draw = d
        return d
    end

    local function hideAll(c)
        if c.draw then for _, o in pairs(c.draw) do o.Visible = false end end
    end

    Players_.PlayerRemoving:Connect(function(plr)
        if cache[plr] then wipeDrawings(cache[plr]) cache[plr] = nil end
    end)

    RunService_.RenderStepped:Connect(function()
        if unloaded then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local myRoot = getRoot(LocalPlayer.Character)
        for _, plr in ipairs(Players_:GetPlayers()) do
            local c = cache[plr]
            if not c then c = {}; cache[plr] = c end
            if plr == LocalPlayer or not Settings.Enabled then
                hideAll(c); wipeDrawings(c)
            else
                local char = plr.Character
                local hum = getHum(char)
                local root = getRoot(char)
                local pass = char and hum and root
                if pass and Settings.AliveCheck and hum.Health <= 0 then pass = false end
                if pass and Settings.TeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then pass = false end
                local dist = 0
                if pass and myRoot then
                    dist = (root.Position - myRoot.Position).Magnitude
                    if dist > Settings.MaxDistance then pass = false end
                end
                if Settings.Chams and char then
                    if not c.chams or c.chamsChar ~= char or not c.chams.Parent then
                        if c.chams then pcall(function() c.chams:Destroy() end) end
                        local h = Instance.new("Highlight")
                        h.FillColor = Settings.Color; h.FillTransparency = 0.55
                        h.OutlineColor = Settings.Color; h.OutlineTransparency = 0
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.Parent = char
                        c.chams, c.chamsChar = h, char
                    else
                        c.chams.FillColor = Settings.Color; c.chams.OutlineColor = Settings.Color
                    end
                elseif c.chams then
                    pcall(function() c.chams:Destroy() end) c.chams, c.chamsChar = nil, nil
                end
                if pass and drawingOK then
                    local d = ensureDrawings(c)
                    local sp, onScreen = cam:WorldToViewportPoint(root.Position)
                    local topSp = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                    local botSp = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                    local h = math.abs(topSp.Y - botSp.Y)
                    local w = h * 0.6
                    local cx, top, bottom = sp.X, topSp.Y, botSp.Y
                    local col = Settings.Color
                    d.box.Visible = Settings.Box and onScreen and h > 4
                    if d.box.Visible then
                        d.box.Color = col
                        d.box.PointA = Vector2.new(cx - w/2, top); d.box.PointB = Vector2.new(cx + w/2, top)
                        d.box.PointC = Vector2.new(cx + w/2, bottom); d.box.PointD = Vector2.new(cx - w/2, bottom)
                    end
                    d.tracer.Visible = Settings.Tracers
                    if d.tracer.Visible then
                        d.tracer.Color = col
                        local vs = cam.ViewportSize
                        local from = Settings.TracerOrigin == 1 and Vector2.new(vs.X/2, vs.Y)
                            or Settings.TracerOrigin == 2 and Vector2.new(vs.X/2, vs.Y/2)
                            or UIS_:GetMouseLocation()
                        d.tracer.From = from; d.tracer.To = Vector2.new(cx, bottom)
                    end
                    d.name.Visible = Settings.Names and onScreen
                    if d.name.Visible then d.name.Text = plr.DisplayName; d.name.Color = col; d.name.Position = Vector2.new(cx, top - 30) end
                    d.dist.Visible = Settings.Distance and onScreen
                    if d.dist.Visible then d.dist.Text = math.floor(dist).."m"; d.dist.Color = Color3.fromRGB(230,230,230); d.dist.Position = Vector2.new(cx, top - 16) end
                    d.hpBg.Visible = Settings.HealthBar and onScreen and h > 4
                    d.hpFill.Visible = d.hpBg.Visible
                    if d.hpBg.Visible then
                        local x = cx - w/2 - 6
                        local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        d.hpBg.From = Vector2.new(x, top); d.hpBg.To = Vector2.new(x, bottom)
                        d.hpFill.Color = Color3.fromHSV(frac * 0.33, 1, 1)
                        d.hpFill.From = Vector2.new(x, bottom - (bottom - top) * frac)
                        d.hpFill.To = Vector2.new(x, bottom)
                    end
                else
                    hideAll(c)
                end
            end
        end
    end)

    -- UI
    local ACCENT = Color3.fromRGB(255, 45, 45)
    local BG = Color3.fromRGB(16, 16, 18)
    local CARD = Color3.fromRGB(32, 32, 36)

    local ScreenGui_ = Instance.new("ScreenGui")
    ScreenGui_.Name = "Imp3rsonESP"
    ScreenGui_.Parent = CoreGui_
    ScreenGui_.ResetOnSpawn = false
    ScreenGui_.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local Window = Instance.new("Frame")
    Window.Parent = ScreenGui_
    Window.BackgroundColor3 = BG
    Window.Position = UDim2.new(0.5, -160, 0.5, -180)
    Window.Size = UDim2.new(0, 320, 0, 360)
    Window.ZIndex = 1
    Instance.new("UICorner", Window).CornerRadius = UDim.new(0, 12)
    local wStroke = Instance.new("UIStroke"); wStroke.Color = ACCENT; wStroke.Thickness = 1.4; wStroke.Parent = Window

    local Title = Instance.new("TextLabel")
    Title.Parent = Window; Title.BackgroundTransparency = 1
    Title.Position = UDim2.new(0, 12, 0, 7); Title.Size = UDim2.new(1, -80, 0, 20)
    Title.Font = Enum.Font.GothamBold; Title.Text = "👁️ Imp3rson ESP  •  PRO"
    Title.TextColor3 = Color3.fromRGB(255,255,255); Title.TextSize = 15
    Title.TextXAlignment = Enum.TextXAlignment.Left; Title.ZIndex = 2

    local underline = Instance.new("Frame")
    underline.Parent = Window; underline.BackgroundColor3 = ACCENT
    underline.Position = UDim2.new(0, 12, 0, 32); underline.Size = UDim2.new(1, -24, 0, 2)
    underline.ZIndex = 2

    local function winBtn(text, xOffset)
        local b = Instance.new("TextButton")
        b.Parent = Window; b.BackgroundColor3 = CARD
        b.Position = UDim2.new(1, xOffset, 0, 4); b.Size = UDim2.new(0, 26, 0, 26)
        b.Font = Enum.Font.GothamBold; b.Text = text
        b.TextColor3 = Color3.fromRGB(255,255,255); b.TextSize = 14; b.ZIndex = 3
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        return b
    end
    local minBtn = winBtn("—", -62)
    local closeBtn = winBtn("X", -32)

    local Body = Instance.new("Frame")
    Body.Parent = Window; Body.BackgroundTransparency = 1
    Body.Position = UDim2.new(0, 0, 0, 40); Body.Size = UDim2.new(1, 0, 1, -40)
    Body.ZIndex = 2

    local function addToggle(i, label, key)
        local row, col = math.floor((i-1)/2), (i-1)%2
        local b = Instance.new("TextButton")
        b.Parent = Body; b.BackgroundColor3 = CARD
        b.Position = UDim2.new(0, 12 + col*152, 0, 8 + row*34)
        b.Size = UDim2.new(0, 144, 0, 30)
        b.Font = Enum.Font.GothamMedium; b.TextColor3 = Color3.fromRGB(255,255,255); b.TextSize = 13; b.ZIndex = 2
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        local function refresh()
            b.Text = (Settings[key] and "● " or "○ ") .. label
            b.BackgroundColor3 = Settings[key] and ACCENT or CARD
        end
        b.MouseButton1Click:Connect(function() Settings[key] = not Settings[key]; refresh() end)
        refresh()
    end
    addToggle(1, "ESP Master", "Enabled")
    addToggle(2, "Box ESP", "Box")
    addToggle(3, "Tracers", "Tracers")
    addToggle(4, "Names", "Names")
    addToggle(5, "Distance", "Distance")
    addToggle(6, "Health Bar", "HealthBar")
    addToggle(7, "Chams", "Chams")
    addToggle(8, "Team Check", "TeamCheck")
    addToggle(9, "Alive Check", "AliveCheck")

    local colorLbl = Instance.new("TextLabel")
    colorLbl.Parent = Body; colorLbl.BackgroundTransparency = 1
    colorLbl.Position = UDim2.new(0, 12, 0, 178); colorLbl.Size = UDim2.new(0, 100, 0, 16)
    colorLbl.Font = Enum.Font.GothamBold; colorLbl.Text = "COLOR"
    colorLbl.TextColor3 = Color3.fromRGB(150,150,150); colorLbl.TextSize = 11
    colorLbl.TextXAlignment = Enum.TextXAlignment.Left; colorLbl.ZIndex = 2

    local COLORS = {
        Color3.fromRGB(255,45,45), Color3.fromRGB(255,150,0), Color3.fromRGB(255,230,0),
        Color3.fromRGB(80,255,120), Color3.fromRGB(0,220,255), Color3.fromRGB(190,80,255),
    }
    local selStrokes = {}
    for i, colr in ipairs(COLORS) do
        local s = Instance.new("TextButton")
        s.Parent = Body; s.Text = ""; s.BackgroundColor3 = colr
        s.Position = UDim2.new(0, 12 + (i-1)*38, 0, 196); s.Size = UDim2.new(0, 30, 0, 30); s.ZIndex = 2
        Instance.new("UICorner", s).CornerRadius = UDim.new(0, 8)
        local st = Instance.new("UIStroke"); st.Color = Color3.new(1,1,1); st.Thickness = 2; st.Transparency = 1; st.Parent = s
        table.insert(selStrokes, st)
        if i == 1 then st.Transparency = 0 end
        s.MouseButton1Click:Connect(function()
            Settings.Color = colr
            for _, x in ipairs(selStrokes) do x.Transparency = 1 end
            st.Transparency = 0
        end)
    end

    local cur = Settings.MaxDistance
    local sLbl = Instance.new("TextLabel")
    sLbl.Parent = Body; sLbl.BackgroundTransparency = 1
    sLbl.Position = UDim2.new(0, 12, 0, 236); sLbl.Size = UDim2.new(0, 118, 0, 30)
    sLbl.Font = Enum.Font.GothamMedium; sLbl.TextColor3 = Color3.fromRGB(255,255,255); sLbl.TextSize = 13
    sLbl.TextXAlignment = Enum.TextXAlignment.Left; sLbl.ZIndex = 2
    local track = Instance.new("Frame")
    track.Parent = Body; track.BackgroundColor3 = Color3.fromRGB(45,45,50)
    track.Position = UDim2.new(0, 132, 0, 246); track.Size = UDim2.new(0, 118, 0, 10); track.ZIndex = 2
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame")
    fill.Parent = track; fill.BackgroundColor3 = ACCENT; fill.Size = UDim2.new(0,0,1,0); fill.ZIndex = 3
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local function sRefresh()
        sLbl.Text = "Max Dist: "..cur.."m"
        fill.Size = UDim2.new((cur-50)/(2000-50), 0, 1, 0)
        Settings.MaxDistance = cur
    end
    local function sSet(v) cur = math.clamp(math.floor(v/50+0.5)*50, 50, 2000); sRefresh() end
    local mBtn = winBtn("-", 0); mBtn.Parent = Body; mBtn.Position = UDim2.new(0, 254, 0, 239); mBtn.Size = UDim2.new(0, 24, 0, 24)
    local pBtn = winBtn("+", 0); pBtn.Parent = Body; pBtn.Position = UDim2.new(0, 282, 0, 239); pBtn.Size = UDim2.new(0, 24, 0, 24)
    mBtn.MouseButton1Click:Connect(function() sSet(cur - 50) end)
    pBtn.MouseButton1Click:Connect(function() sSet(cur + 50) end)
    local sliding = false
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            sSet(50 + 1950 * math.clamp((i.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X, 0, 1))
        end
    end)
    track.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            sSet(50 + 1950 * math.clamp((i.Position.X - track.AbsolutePosition.X)/track.AbsoluteSize.X, 0, 1))
        end
    end)
    track.InputEnded:Connect(function() sliding = false end)
    sRefresh()

    local orgBtn = Instance.new("TextButton")
    orgBtn.Parent = Body; orgBtn.BackgroundColor3 = CARD
    orgBtn.Position = UDim2.new(0, 12, 0, 276); orgBtn.Size = UDim2.new(0, 144, 0, 30)
    orgBtn.Font = Enum.Font.GothamMedium; orgBtn.TextColor3 = Color3.fromRGB(255,255,255); orgBtn.TextSize = 13; orgBtn.ZIndex = 2
    Instance.new("UICorner", orgBtn).CornerRadius = UDim.new(0, 8)
    orgBtn.Text = "Tracer: "..ORIGINS[Settings.TracerOrigin]
    orgBtn.MouseButton1Click:Connect(function()
        Settings.TracerOrigin = Settings.TracerOrigin % 3 + 1
        orgBtn.Text = "Tracer: "..ORIGINS[Settings.TracerOrigin]
    end)

    local footer = Instance.new("TextLabel")
    footer.Parent = Body; footer.BackgroundTransparency = 1
    footer.Position = UDim2.new(0, 164, 0, 276); footer.Size = UDim2.new(0, 144, 0, 30)
    footer.Font = Enum.Font.GothamMedium; footer.Text = "Imp3rson © 2026"
    footer.TextColor3 = Color3.fromRGB(110,110,110); footer.TextSize = 11; footer.ZIndex = 2

    -- Drag
    local dragFrame = Instance.new("Frame")
    dragFrame.Parent = Window; dragFrame.BackgroundTransparency = 1
    dragFrame.Position = UDim2.new(0, 0, 0, 0); dragFrame.Size = UDim2.new(1, -70, 0, 34); dragFrame.ZIndex = 2
    local dragging, dragStart, startPos = false, nil, nil
    dragFrame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = i.Position; startPos = Window.Position
            i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UIS_.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - dragStart
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Body.Visible = not minimized
        minBtn.Text = minimized and "□" or "—"
        Window.Size = minimized and UDim2.new(0, 320, 0, 40) or UDim2.new(0, 320, 0, 360)
    end)

    local function cleanupESP()
        unloaded = true
        for _, c in pairs(cache) do wipeDrawings(c) end
        cache = {}
        ScreenGui_:Destroy()
    end
    closeBtn.MouseButton1Click:Connect(cleanupESP)

    -- Botão flutuante do ESP
    local floatBtn = Instance.new("TextButton")
    floatBtn.Parent = ScreenGui_
    floatBtn.BackgroundColor3 = ACCENT
    floatBtn.Position = UDim2.new(0, 8, 0.5, -23)
    floatBtn.Size = UDim2.new(0, 46, 0, 46)
    floatBtn.Font = Enum.Font.GothamBold; floatBtn.Text = "👁️"
    floatBtn.TextColor3 = Color3.fromRGB(255,255,255); floatBtn.TextSize = 20; floatBtn.ZIndex = 6
    Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(1, 0)
    local fbS = Instance.new("UIStroke"); fbS.Color = Color3.new(1,1,1); fbS.Thickness = 1.5; fbS.Parent = floatBtn
    floatBtn.MouseButton1Click:Connect(function() Window.Visible = not Window.Visible end)

    print("[✅] Imp3rson ESP PRO carregado!")
end

